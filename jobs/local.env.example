# Copy to jobs/local.env. This file is sourced by jobs/run.pbs.

# Environment created by jobs/setup_env.sh. Prefer an absolute storage path.
LATIUM_ENV="$HOME/.conda/envs/latium"

# Persistent Hugging Face cache. Latium's own ../models and ../datasets paths
# remain unchanged; this only controls caches used by HF libraries.
# LATIUM_CACHE_ROOT="/storage/CITY/home/USER/latium-cache"

# Optional token for gated models. Prefer exporting it before qsub if possible.
# HF_TOKEN="hf_..."

# Optional allocator setting useful for fragmented CUDA workloads.
PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
